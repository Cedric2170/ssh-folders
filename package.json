{
  "name": "ssh-folders",
  "displayName": "%sshFolders.displayName%",
  "description": "%sshFolders.description%",
  "version": "0.3.1",
  "publisher": "cedric217",
  "author": "Cédric",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cedric2170/ssh-folders.git"
  },
  "bugs": {
    "url": "https://github.com/Cedric2170/ssh-folders/issues"
  },
  "homepage": "https://github.com/Cedric2170/ssh-folders#readme",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "remote",
    "folders"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sshFoldersContainer",
          "title": "%sshFolders.viewsContainer.title%",
          "icon": "media/ssh-folders.svg"
        }
      ]
    },
    "views": {
      "sshFoldersContainer": [
        {
          "id": "sshFolders",
          "name": "%sshFolders.view.name%",
          "icon": "media/ssh-folders.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sshFolders",
        "contents": "%sshFolders.viewsWelcome.byHost%",
        "when": "sshFolders.view == byHost"
      },
      {
        "view": "sshFolders",
        "contents": "%sshFolders.viewsWelcome.byFolder%",
        "when": "sshFolders.view == byFolder"
      },
      {
        "view": "sshFolders",
        "contents": "%sshFolders.viewsWelcome.recent%",
        "when": "sshFolders.view == recent"
      }
    ],
    "commands": [
      {
        "command": "sshFolders.showByFolder",
        "title": "%sshFolders.command.showByFolder%",
        "category": "%sshFolders.command.category%",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "sshFolders.showByRecent",
        "title": "%sshFolders.command.showByRecent%",
        "category": "%sshFolders.command.category%",
        "icon": "$(history)"
      },
      {
        "command": "sshFolders.showByHost",
        "title": "%sshFolders.command.showByHost%",
        "category": "%sshFolders.command.category%",
        "icon": "$(list-tree)"
      },
      {
        "command": "sshFolders.refresh",
        "title": "%sshFolders.command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "sshFolders.addFolder",
        "title": "%sshFolders.command.addFolder%",
        "icon": "$(add)"
      },
      {
        "command": "sshFolders.renameFolder",
        "title": "%sshFolders.command.renameFolder%"
      },
      {
        "command": "sshFolders.removeFolder",
        "title": "%sshFolders.command.removeFolder%"
      },
      {
        "command": "sshFolders.toggleFavorite",
        "title": "%sshFolders.command.toggleFavorite%",
        "icon": "$(star)"
      },
      {
        "command": "sshFolders.removeRecent",
        "title": "%sshFolders.command.removeRecent%",
        "category": "%sshFolders.command.category%",
        "icon": "$(remove)"
      },
      {
        "command": "sshFolders.openFoldersConfig",
        "title": "%sshFolders.command.openFoldersConfig%",
        "icon": "$(json)"
      },
      {
        "command": "sshFolders.openSshConfig",
        "title": "%sshFolders.command.openSshConfig%"
      },
      {
        "command": "sshFolders.openInCurrentWindow",
        "title": "%sshFolders.command.openInCurrentWindow%",
        "category": "%sshFolders.command.category%",
        "icon": "$(window)"
      },
      {
        "command": "sshFolders.openInNewWindow",
        "title": "%sshFolders.command.openInNewWindow%",
        "category": "%sshFolders.command.category%",
        "icon": "$(empty-window)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sshFolders.showByFolder",
          "when": "view == sshFolders && sshFolders.view == byHost",
          "group": "navigation@0"
        },
        {
          "command": "sshFolders.showByRecent",
          "when": "view == sshFolders && sshFolders.view == byFolder",
          "group": "navigation@0"
        },
        {
          "command": "sshFolders.showByHost",
          "when": "view == sshFolders && sshFolders.view == recent",
          "group": "navigation@0"
        },
        {
          "command": "sshFolders.refresh",
          "when": "view == sshFolders",
          "group": "navigation@1"
        },
        {
          "command": "sshFolders.addFolder",
          "when": "view == sshFolders",
          "group": "navigation@2"
        },
        {
          "command": "sshFolders.openFoldersConfig",
          "when": "view == sshFolders",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "sshFolders.openInCurrentWindow",
          "when": "view == sshFolders && (viewItem == host || viewItem == recentHost || viewItem == localHost || viewItem == recentLocalHost)",
          "group": "inline@1"
        },
        {
          "command": "sshFolders.openInNewWindow",
          "when": "view == sshFolders && (viewItem == host || viewItem == recentHost || viewItem == localHost || viewItem == recentLocalHost)",
          "group": "inline@2"
        },
        {
          "command": "sshFolders.addFolder",
          "when": "view == sshFolders && (viewItem == host || viewItem == localHost)",
          "group": "inline@3"
        },
        {
          "command": "sshFolders.openInCurrentWindow",
          "when": "view == sshFolders && (viewItem == folder || viewItem == recentFolder || viewItem == localFolder || viewItem == recentLocalFolder)",
          "group": "inline@1"
        },
        {
          "command": "sshFolders.openInNewWindow",
          "when": "view == sshFolders && (viewItem == folder || viewItem == recentFolder || viewItem == localFolder || viewItem == recentLocalFolder)",
          "group": "inline@2"
        },
        {
          "command": "sshFolders.removeRecent",
          "when": "view == sshFolders && (viewItem == recentHost || viewItem == recentFolder || viewItem == recentLocalHost || viewItem == recentLocalFolder)",
          "group": "inline@9"
        },
        {
          "command": "sshFolders.openInCurrentWindow",
          "when": "view == sshFolders && (viewItem == host || viewItem == folder || viewItem == recentHost || viewItem == recentFolder || viewItem == localHost || viewItem == localFolder || viewItem == recentLocalHost || viewItem == recentLocalFolder)",
          "group": "0_connect@1"
        },
        {
          "command": "sshFolders.openInNewWindow",
          "when": "view == sshFolders && (viewItem == host || viewItem == folder || viewItem == recentHost || viewItem == recentFolder || viewItem == localHost || viewItem == localFolder || viewItem == recentLocalHost || viewItem == recentLocalFolder)",
          "group": "0_connect@2"
        },
        {
          "command": "sshFolders.toggleFavorite",
          "when": "view == sshFolders && (viewItem == host || viewItem == localHost || viewItem == folder || viewItem == localFolder)",
          "group": "inline@4"
        },
        {
          "command": "sshFolders.toggleFavorite",
          "when": "view == sshFolders && (viewItem == host || viewItem == localHost || viewItem == folder || viewItem == localFolder)",
          "group": "1_edit@0"
        },
        {
          "command": "sshFolders.renameFolder",
          "when": "view == sshFolders && (viewItem == folder || viewItem == localFolder)",
          "group": "1_edit@1"
        },
        {
          "command": "sshFolders.removeFolder",
          "when": "view == sshFolders && (viewItem == folder || viewItem == localFolder)",
          "group": "1_edit@2"
        }
      ],
      "commandPalette": [
        {
          "command": "sshFolders.openInCurrentWindow",
          "when": "false"
        },
        {
          "command": "sshFolders.openInNewWindow",
          "when": "false"
        },
        {
          "command": "sshFolders.removeRecent",
          "when": "false"
        },
        {
          "command": "sshFolders.toggleFavorite",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%sshFolders.config.title%",
      "properties": {
        "sshFolders.configPath": {
          "type": "string",
          "default": "",
          "description": "%sshFolders.config.configPath%"
        },
        "sshFolders.view": {
          "type": "string",
          "enum": [
            "byHost",
            "byFolder",
            "recent"
          ],
          "enumDescriptions": [
            "%sshFolders.config.view.byHost%",
            "%sshFolders.config.view.byFolder%",
            "%sshFolders.config.view.recent%"
          ],
          "default": "byHost",
          "description": "%sshFolders.config.view%"
        }
      }
    },
    "colors": [
      {
        "id": "sshFolders.activeForeground",
        "description": "%sshFolders.color.activeForeground%",
        "defaults": {
          "dark": "#3fb950",
          "light": "#1a7f37",
          "highContrast": "#3fb950",
          "highContrastLight": "#1a7f37"
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "ssh-folders.json",
          "**/ssh-folders.json"
        ],
        "url": "./schemas/remote-folders.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "l10n:export": "npx @vscode/l10n-dev export --outDir ./l10n ./src",
    "test": "npm run compile && node --require ./test/register-vscode-mock.js --test out/test/**/*.test.js",
    "dev:host": "npm run compile && printf 'real\\n' > .vscode/ssh-folders-dev.mode && cursor --extensionDevelopmentPath=\"$PWD\"",
    "dev:host:exemples": "npm run compile && printf 'sandbox\\n' > .vscode/ssh-folders-dev.mode && cursor --extensionDevelopmentPath=\"$PWD\"",
    "dev:host:exemples:reset": "npm run compile && printf 'sandbox\\n' > .vscode/ssh-folders-dev.mode && SSH_FOLDERS_DEV_RESET=1 cursor --extensionDevelopmentPath=\"$PWD\"",
    "watch": "tsc -watch -p ./",
    "package": "mkdir -p vsix && node scripts/vsix-readme.js && vsce package -o vsix",
    "release:main": "bash scripts/release-main.sh",
    "publish:vscode": "npm run package && vsce publish -i vsix/ssh-folders-$(node -p \"require('./package.json').version\").vsix",
    "publish:openvsx": "npx ovsx publish vsix/ssh-folders-$(node -p \"require('./package.json').version\").vsix"
  },
  "dependencies": {
    "ssh-config": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^6.0.3"
  }
}
