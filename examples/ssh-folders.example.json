{
  "$schema": "../schemas/remote-folders.schema.json",
  "defaults": {
    "DefaultFolder": "/opt/docker/projects",
    "RecentLimit": 20,
    "ActiveColor": "green",
    "SortAlphabetical": true,
    "GroupSameName": true,
    "HiddenHosts": [],
    "FavoriteHosts": ["demo-docker"],
    "LastFolder": ["Projects", "_old"],
    "ArchiveParents": ["_old", "old"]
  },
  "local": [
    {
      "VirtualHost": "Prod",
      "path": "~/Documents/Projets",
      "label": "Projets",
      "favorite": true
    },
    {
      "VirtualHost": "Prod",
      "path": "~/Documents/Notes",
      "label": "Notes"
    },
    {
      "VirtualHost": "Dev",
      "path": "~/dev/sandbox",
      "label": "Sandbox"
    }
  ],
  "folders": {
    "demo-docker": [
      {
        "path": "/opt/docker/projects",
        "label": "Projects"
      },
      {
        "path": "/opt/docker/projects/grafana",
        "label": "Grafana",
        "favorite": true
      },
      {
        "path": "/opt/docker/projects/guacamole",
        "label": "Guacamole"
      },
      {
        "path": "/opt/docker/projects/_old",
        "label": "_old"
      },
      {
        "path": "/opt/docker/projects/_old/legacy-api",
        "label": "Legacy-api"
      },
      {
        "path": "/opt/docker/projects/_old/old-portal",
        "label": "Old-portal"
      }
    ],
    "demo-web": [
      {
        "path": "/opt/docker/projects/census-agent",
        "label": "Census-agent"
      },
      {
        "path": "/etc/nginx"
      }
    ]
  }
}
